[Unit]
Description=TDR Trading Server
After=network.target

[Service]
Type=simple
User=chris
Group=staff
WorkingDirectory=/Users/chris/projects/python/btc
Environment="PATH=/Users/chris/projects/python/btc/env/bin:/usr/local/bin:/usr/bin:/bin"
Environment="USE_DATA_CACHE=1"
ExecStart=/Users/chris/projects/python/btc/env/bin/python src/tdr_server.py
ExecStop=/usr/bin/curl -X POST http://localhost:4000/api/shutdown
Restart=on-failure
RestartSec=10
StandardOutput=append:/Users/chris/projects/python/btc/logs/server.log
StandardError=append:/Users/chris/projects/python/btc/logs/server.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target