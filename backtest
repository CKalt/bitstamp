#!/bin/bash
# Safe backtesting wrapper that prevents accidental overwrites

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if trying to overwrite best_strategy.json
OUTPUT_FILE=""
for arg in "$@"; do
    if [[ "$arg" == "--output-file" ]]; then
        OUTPUT_FILE="next"
    elif [[ "$OUTPUT_FILE" == "next" ]]; then
        OUTPUT_FILE="$arg"
        break
    fi
done

# Default to safe test file if no output specified
if [[ -z "$OUTPUT_FILE" ]]; then
    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    OUTPUT_FILE="test_strategy_${TIMESTAMP}.json"
    echo -e "${YELLOW}No --output-file specified. Using: ${OUTPUT_FILE}${NC}"
fi

# Warn if trying to overwrite production config
if [[ "$OUTPUT_FILE" == "best_strategy.json" ]]; then
    echo -e "${RED}WARNING: Attempting to overwrite best_strategy.json!${NC}"
    echo -e "${RED}This will affect your LIVE TRADING configuration.${NC}"
    read -p "Are you SURE you want to continue? (type 'yes' to confirm): " confirm
    if [[ "$confirm" != "yes" ]]; then
        echo -e "${GREEN}Cancelled. Your production config is safe.${NC}"
        exit 1
    fi
fi

# Run the backtester
echo -e "${GREEN}Running backtest...${NC}"
python src/bktst_enhanced_shared.py "$@"

# Show results location
if [[ $? -eq 0 ]] && [[ "$OUTPUT_FILE" != "best_strategy.json" ]]; then
    echo -e "\n${GREEN}Results saved to: ${OUTPUT_FILE}${NC}"
    echo -e "To apply these settings to production:"
    echo -e "  1. Review: cat ${OUTPUT_FILE}"
    echo -e "  2. Backup: cp best_strategy.json best_strategy.backup.json"
    echo -e "  3. Apply:  cp ${OUTPUT_FILE} best_strategy.json"
fi